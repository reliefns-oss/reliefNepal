# Server
PORT=4000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3010

# PostgreSQL (cPanel) - Use either DATABASE_URL or individual params
DATABASE_URL=postgresql://user:password@localhost:5432/reliefnepal_api
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=reliefnepal_api
# PGUSER=reliefnepal_user
# PGPASSWORD=your-secure-password

# JWT for Admin Authentication (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRES_IN=8h

# File Storage (cPanel local)
UPLOAD_ROOT=/home/reliefnepalorg/uploads
UPLOAD_URL_PREFIX=/uploads
MAX_FILE_SIZE=8388608
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/avif